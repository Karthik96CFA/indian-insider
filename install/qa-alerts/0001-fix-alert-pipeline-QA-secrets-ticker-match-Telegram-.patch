+import { describe, expect, it } from 'vitest'
+import {
+  resolveSignalTicker,
+  signalDisplayName,
+  signalMatchesHolding,
+  buildHoldingsTickerMap,
+} from './signalSymbols'
+import type { Holding } from '@/server/db/schema'
+
+const holding = (ticker: string): Holding =>
+  ({
+    id: '1',
+    user_id: 'u1',
+    ticker,
+    company_name: `${ticker} Ltd`,
+    buy_price: '100',
+    quantity: '10',
+    status: 'active',
+  }) as Holding
+
+describe('resolveSignalTicker', () => {
+  it('prefers payload ticker over legacy company symbol', () => {
+    expect(
+      resolveSignalTicker({
+        symbol: 'Reliance Industries Ltd',
+        payloadJson: { ticker: 'RELIANCE' },
+      }),
+    ).toBe('RELIANCE')
+  })
+
+  it('falls back to symbol field', () => {
+    expect(resolveSignalTicker({ symbol: 'tcs' })).toBe('TCS')
+  })
+})
+
+describe('signalDisplayName', () => {
+  it('shows company name when present', () => {
+    expect(
+      signalDisplayName({
+        symbol: 'RELIANCE',
+        payloadJson: { company_name: 'Reliance Industries Ltd' },
+      }),
+    ).toBe('Reliance Industries Ltd')
+  })
+})
+
+describe('signalMatchesHolding', () => {
+  it('matches holdings by payload ticker', () => {
+    const map = buildHoldingsTickerMap([holding('RELIANCE')])
+    expect(
+      signalMatchesHolding(
+        { symbol: 'Reliance Industries Ltd', payloadJson: { ticker: 'RELIANCE' } },
+        map,
+      ),
+    ).toBe(true)
+  })
+})
diff --git a/src/utils/signalSymbols.ts b/src/utils/signalSymbols.ts
new file mode 100644
index 0000000..7d9e7fe
--- /dev/null
+++ b/src/utils/signalSymbols.ts
@@ -0,0 +1,66 @@
+import type { Holding, WatchlistItem } from '@/server/db/schema'
+
+type SignalLike = {
+  symbol: string
+  payloadJson?: unknown
+}
+
+function payloadRecord(payload: unknown): Record<string, unknown> | null {
+  if (!payload || typeof payload !== 'object' || Array.isArray(payload)) return null
+  return payload as Record<string, unknown>
+}
+
+/** Resolve NSE ticker from signal row (handles legacy company-name symbols). */
+export function resolveSignalTicker(signal: SignalLike): string {
+  const payload = payloadRecord(signal.payloadJson)
+  const fromPayload = payload?.ticker
+  if (typeof fromPayload === 'string' && fromPayload.trim()) {
+    return fromPayload.trim().toUpperCase()
+  }
+  return signal.symbol.trim().toUpperCase()
+}
+
+export function signalDisplayName(signal: SignalLike): string {
+  const payload = payloadRecord(signal.payloadJson)
+  const company = payload?.company_name
+  if (typeof company === 'string' && company.trim()) return company.trim()
+  return resolveSignalTicker(signal)
+}
+
+export function buildHoldingsTickerMap(holdings: Holding[]): Map<string, Holding> {
+  const map = new Map<string, Holding>()
+  for (const h of holdings) {
+    map.set(h.ticker.toUpperCase(), h)
+  }
+  return map
+}
+
+export function buildWatchlistTickerSet(watchlist: WatchlistItem[]): Set<string> {
+  return new Set(watchlist.map((w) => w.ticker.toUpperCase()))
+}
+
+export function findMatchingHolding(
+  signal: SignalLike,
+  holdingsMap: Map<string, Holding>,
+): Holding | undefined {
+  const ticker = resolveSignalTicker(signal)
+  const direct = holdingsMap.get(ticker)
+  if (direct) return direct
+
+  const payload = payloadRecord(signal.payloadJson)
+  const scrip = payload?.scrip_code
+  if (typeof scrip === 'string') {
+    for (const h of holdingsMap.values()) {
+      if (h.ticker.toUpperCase() === scrip.toUpperCase()) return h
+    }
+  }
+  return undefined
+}
+
+export function signalMatchesHolding(signal: SignalLike, holdingsMap: Map<string, Holding>): boolean {
+  return findMatchingHolding(signal, holdingsMap) !== undefined
+}
+
+export function signalMatchesWatchlist(signal: SignalLike, watchlist: Set<string>): boolean {
+  return watchlist.has(resolveSignalTicker(signal))
+}
