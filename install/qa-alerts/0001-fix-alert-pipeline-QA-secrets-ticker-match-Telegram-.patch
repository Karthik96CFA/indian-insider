+/** Shared secret for /api/integrations/signals — accepts either env name. */
+export function getIntegrationSecret(): string | undefined {
+  const a = process.env.INTEGRATION_SECRET?.trim()
+  const b = process.env.STOCKLENS_INTEGRATION_SECRET?.trim()
+  return a || b || undefined
+}
+
+export function integrationSecretRequired(): boolean {
+  return process.env.NODE_ENV === 'production'
+}
