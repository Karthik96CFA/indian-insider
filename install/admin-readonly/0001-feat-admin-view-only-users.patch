diff --git a/src/server/auth/appAccess.ts b/src/server/auth/appAccess.ts
new file mode 100644
index 0000000..c4ce606
--- /dev/null
+++ b/src/server/auth/appAccess.ts
@@ -0,0 +1,71 @@
+import 'server-only'
+
+import { eq } from 'drizzle-orm'
+import { db } from '@/server/db'
+import { userSettings } from '@/server/db/schema'
+import { getAuthenticatedUserId } from '@/server/db/supabase'
+
+let cachedAdminUserId: string | null | undefined
+
+export async function getAdminUserId(): Promise<string | null> {
+  if (cachedAdminUserId !== undefined) return cachedAdminUserId
+
+  const [row] = await db
+    .select({ user_id: userSettings.user_id })
+    .from(userSettings)
+    .where(eq(userSettings.is_admin, true))
+    .limit(1)
+
+  cachedAdminUserId = row?.user_id ?? null
+  return cachedAdminUserId
+}
+
+export async function isUserAdmin(userId: string): Promise<boolean> {
+  const [row] = await db
+    .select({ is_admin: userSettings.is_admin })
+    .from(userSettings)
+    .where(eq(userSettings.user_id, userId))
+    .limit(1)
+
+  return row?.is_admin ?? false
+}
+
+export async function getIsAdmin(): Promise<boolean> {
+  const userId = await getAuthenticatedUserId()
+  return isUserAdmin(userId)
+}
+
+export async function requireAdmin(): Promise<void> {
+  if (!(await getIsAdmin())) {
+    throw new Error('Admin access required')
+  }
+}
+
+/** Portfolio/pool data owner — admin's account for read-only users. */
+export async function getDataUserId(): Promise<string> {
+  const userId = await getAuthenticatedUserId()
+  if (await isUserAdmin(userId)) return userId
+
+  const adminId = await getAdminUserId()
+  return adminId ?? userId
+}
+
+/** Promote ADMIN_EMAIL user to admin on login (set ADMIN_EMAIL in Railway). */
+export async function ensureAdminOnLogin(userId: string, email: string): Promise<void> {
+  const adminEmail = process.env.ADMIN_EMAIL?.trim().toLowerCase()
+  if (!adminEmail || email.trim().toLowerCase() !== adminEmail) return
+
+  await db
+    .insert(userSettings)
+    .values({ user_id: userId, is_admin: true })
+    .onConflictDoUpdate({
+      target: userSettings.user_id,
+      set: { is_admin: true },
+    })
+
+  cachedAdminUserId = userId
+}
+
+export function isPublicSignupAllowed(): boolean {
+  return process.env.ALLOW_PUBLIC_SIGNUP === 'true'
+}
