+'use client'
+
+import { createContext, useContext } from 'react'
+
+interface AppAccessContextValue {
+  isAdmin: boolean
+  isReadOnly: boolean
+}
+
+const AppAccessContext = createContext<AppAccessContextValue>({
+  isAdmin: false,
+  isReadOnly: true,
+})
+
+export function AppAccessProvider({
+  isAdmin,
+  children,
+}: {
+  isAdmin: boolean
+  children: React.ReactNode
+}) {
+  return (
+    <AppAccessContext.Provider value={{ isAdmin, isReadOnly: !isAdmin }}>
+      {children}
+    </AppAccessContext.Provider>
+  )
+}
+
+export function useAppAccess() {
+  return useContext(AppAccessContext)
+}
