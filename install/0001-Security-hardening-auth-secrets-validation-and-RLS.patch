@@ -30,15 +30,34 @@ from common import ConsensusEvent, Signal, _conn, log
 
 def _base_url() -> str | None:
     url = (os.environ.get("STOCKLENS_URL") or "").strip().rstrip("/")
-    return url or None
+    if not url:
+        return None
+    from urllib.parse import urlparse
+    import ipaddress
+
+    parsed = urlparse(url)
+    if parsed.scheme != "https" or not parsed.hostname:
+        log("stocklens", "STOCKLENS_URL must be https with a valid hostname")
+        return None
+    host = parsed.hostname.lower()
+    try:
+        ipaddress.ip_address(host)
+        log("stocklens", "STOCKLENS_URL must not use a raw IP address")
+        return None
+    except ValueError:
+        pass
+    if host in ("localhost", "127.0.0.1") or host.endswith(".local"):
+        log("stocklens", "STOCKLENS_URL must be your production Railway hostname")
+        return None
+    return url
 
 
 def _headers() -> dict[str, str]:
-    h = {"Content-Type": "application/json"}
     secret = os.environ.get("STOCKLENS_INTEGRATION_SECRET", "").strip()
-    if secret:
-        h["X-Integration-Secret"] = secret
-    return h
+    if not secret:
+        log("stocklens", "STOCKLENS_INTEGRATION_SECRET is required")
+        return {}
+    return {"Content-Type": "application/json", "X-Integration-Secret": secret}
 
 
 def _event_hash(*parts: str) -> str:
@@ -53,15 +72,18 @@ def push_signal_payload(payload: dict) -> bool:
