+ALTER TABLE signal_events               ENABLE ROW LEVEL SECURITY;
 
 -- ── holdings ─────────────────────────────────────────────────
 
@@ -273,3 +274,14 @@ CREATE POLICY "research_documents: users see own rows"
   ON research_documents FOR ALL
   USING (auth.uid() = user_id)
   WITH CHECK (auth.uid() = user_id);
+
+-- ── signal_events — global read for authenticated users; writes via server only ──
+
+CREATE POLICY "signal_events: authenticated read"
+  ON signal_events FOR SELECT
+  USING (auth.role() = 'authenticated');
+
+CREATE POLICY "signal_events: authenticated update status"
+  ON signal_events FOR UPDATE
+  USING (auth.role() = 'authenticated')
+  WITH CHECK (auth.role() = 'authenticated');
