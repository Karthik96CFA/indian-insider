+++ b/src/lib/integrationSignalSchema.ts
@@ -0,0 +1,19 @@
+import { z } from 'zod'
+
+const symbolRe = /^[A-Z0-9&.-]{1,20}$/
+
+export const integrationSignalSchema = z.object({
+  symbol: z.string().trim().toUpperCase().regex(symbolRe, 'Invalid symbol'),
+  event_type: z.string().trim().min(1).max(64),
+  category: z.enum(['risk', 'catalyst', 'positioning', 'governance', 'macro']),
+  severity: z.enum(['info', 'warning', 'critical']),
+  signal_strength: z.number().int().min(0).max(100).optional(),
+  confidence: z.enum(['LOW', 'MEDIUM', 'HIGH']),
+  source_engine: z.string().trim().min(1).max(64),
+  payload_json: z.record(z.unknown()).optional(),
+  event_hash: z.string().trim().min(8).max(128),
+  cooldown_minutes: z.number().int().min(1).max(10080).optional(),
+  ttl_days: z.number().int().min(1).max(90).optional(),
+})
+
+export type IntegrationSignalPayload = z.infer<typeof integrationSignalSchema>
diff --git a/src/lib/rateLimit.ts b/src/lib/rateLimit.ts
new file mode 100644
index 0000000..903bed5
--- /dev/null
+++ b/src/lib/rateLimit.ts
@@ -0,0 +1,15 @@
+const buckets = new Map<string, { count: number; windowStart: number }>()
+
+/** Simple in-process rate limit (per Railway instance). */
+export function isRateLimited(key: string, maxRequests: number, windowMs: number): boolean {
+  const now = Date.now()
+  const record = buckets.get(key)
+
+  if (!record || now - record.windowStart > windowMs) {
+    buckets.set(key, { count: 1, windowStart: now })
+    return false
+  }
+
+  record.count += 1
+  return record.count > maxRequests
+}
