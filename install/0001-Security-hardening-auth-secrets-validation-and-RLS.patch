@@ -25,6 +25,7 @@ ALTER TABLE pool_assets                 ENABLE ROW LEVEL SECURITY;
 ALTER TABLE pool_investors              ENABLE ROW LEVEL SECURITY;
 ALTER TABLE pool_investor_units         ENABLE ROW LEVEL SECURITY;
