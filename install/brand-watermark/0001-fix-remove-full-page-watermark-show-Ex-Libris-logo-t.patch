index 0000000..8089339
--- /dev/null
+++ b/src/components/layout/BrandLogo.tsx
@@ -0,0 +1,21 @@
+import Image from 'next/image'
+
+interface BrandLogoProps {
+  className?: string
+}
+
+/** Ex Libris stamp — original PNG, no filters or opacity tricks. */
