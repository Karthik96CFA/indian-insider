 src/app/(auth)/signup/page.tsx           |  2 +
 src/app/globals.css                      | 52 ------------------------
 src/app/layout.tsx                       |  2 -
 src/components/layout/BrandLogo.tsx      | 21 ++++++++++
 src/components/layout/BrandWatermark.tsx |  4 --
 src/components/layout/TopHeader.tsx      |  2 +
 7 files changed, 27 insertions(+), 58 deletions(-)
 create mode 100644 src/components/layout/BrandLogo.tsx
 delete mode 100644 src/components/layout/BrandWatermark.tsx

