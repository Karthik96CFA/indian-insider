+import 'server-only'
+
+import { eq } from 'drizzle-orm'
+import { db } from '@/server/db'
+import { userSettings } from '@/server/db/schema'
+import { createSupabaseServiceClient } from '@/server/db/supabase'
+
+export interface AppUserRow {
+  id: string
+  email: string
+  isAdmin: boolean
+  createdAt: string
+  lastSignInAt: string | null
+  emailConfirmed: boolean
+}
+
+export async function listAppUsers(): Promise<AppUserRow[]> {
+  const supabase = createSupabaseServiceClient()
+  const { data, error } = await supabase.auth.admin.listUsers({ page: 1, perPage: 200 })
+  if (error) throw new Error(error.message)
+
+  const settings = await db.select().from(userSettings)
+  const adminByUser = new Map(settings.map((s) => [s.user_id, s.is_admin]))
+
+  return (data.users ?? [])
+    .filter((u) => u.email)
+    .map((u) => ({
+      id:               u.id,
+      email:            u.email!,
+      isAdmin:          adminByUser.get(u.id) ?? false,
+      createdAt:        u.created_at,
+      lastSignInAt:     u.last_sign_in_at ?? null,
+      emailConfirmed:   Boolean(u.email_confirmed_at),
+    }))
+    .sort((a, b) => a.email.localeCompare(b.email))
+}
+
+export async function countAdmins(): Promise<number> {
+  const rows = await db
+    .select({ id: userSettings.id })
+    .from(userSettings)
+    .where(eq(userSettings.is_admin, true))
+  return rows.length
+}
+
+export async function deleteUserSettings(userId: string): Promise<void> {
+  await db.delete(userSettings).where(eq(userSettings.user_id, userId))
+}
