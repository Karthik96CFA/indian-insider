+            disabled={isPending || !email.trim()}
+            className="btn-primary py-2 px-4 text-sm justify-center shrink-0"
+          >
+            {isPending ? <Loader2 size={14} className="animate-spin" /> : <Mail size={14} />}
+            Send invite
+          </button>
+        </div>
+      </div>
+
+      <div className="card rounded-xl border border-[#1c212a] bg-[#0b0e14] overflow-hidden">
+        <div className="px-5 py-3 border-b border-[#1c212a]">
+          <h2 className="text-sm font-semibold text-[#f1f5f9]">
+            Users ({users.length})
+          </h2>
+        </div>
+
+        {users.length === 0 ? (
+          <p className="px-5 py-8 text-sm text-[#64748b] text-center">No users yet.</p>
+        ) : (
+          <div className="divide-y divide-[#1c212a]/60">
+            {users.map((user) => {
+              const isSelf = user.id === currentUserId
+              const status = user.emailConfirmed
+                ? user.lastSignInAt
+                  ? 'Active'
+                  : 'Confirmed'
+                : 'Invite pending'
+
+              return (
+                <div
+                  key={user.id}
+                  className="px-5 py-3 flex flex-col sm:flex-row sm:items-center gap-3 justify-between"
+                >
+                  <div className="min-w-0">
+                    <div className="flex items-center gap-2 flex-wrap">
+                      <span className="text-sm font-medium text-[#e2e8f0] truncate">{user.email}</span>
+                      {isSelf && (
+                        <span className="text-[9px] uppercase font-bold px-1.5 py-0.5 rounded bg-[#3b82f6]/15 text-[#60a5fa]">
+                          You
+                        </span>
+                      )}
+                      <span
+                        className={`inline-flex items-center gap-1 text-[9px] uppercase font-bold px-1.5 py-0.5 rounded ${
+                          user.isAdmin
+                            ? 'bg-[#22c55e]/15 text-[#22c55e]'
+                            : 'bg-[#64748b]/15 text-[#94a3b8]'
+                        }`}
+                      >
+                        {user.isAdmin ? <Shield size={10} /> : <Eye size={10} />}
+                        {user.isAdmin ? 'Admin' : 'View only'}
+                      </span>
+                      <span
+                        className={`text-[9px] uppercase font-bold px-1.5 py-0.5 rounded ${
+                          status === 'Active'
+                            ? 'bg-[#22c55e]/10 text-[#22c55e]'
+                            : status === 'Invite pending'
+                              ? 'bg-[#f59e0b]/10 text-[#fbbf24]'
+                              : 'bg-[#3b82f6]/10 text-[#60a5fa]'
+                        }`}
+                      >
+                        {status}
+                      </span>
+                    </div>
+                    <p className="text-[10px] text-[#64748b] mt-1 font-mono">
+                      Joined {formatWhen(user.createdAt)}
+                      {user.lastSignInAt ? ` · Last sign-in ${formatWhen(user.lastSignInAt)}` : ''}
+                    </p>
+                  </div>
+
+                  {!isSelf && (
+                    <div className="flex items-center gap-2 shrink-0">
+                      {!user.emailConfirmed && (
+                        <button
+                          type="button"
