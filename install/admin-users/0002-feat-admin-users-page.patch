+
+interface Props {
+  users: AppUserRow[]
+  currentUserId: string
+}
+
+function formatWhen(iso: string | null): string {
+  if (!iso) return '—'
+  return new Date(iso).toLocaleString('en-IN', {
+    day: 'numeric',
+    month: 'short',
+    year: '2-digit',
+    hour: '2-digit',
+    minute: '2-digit',
+  })
+}
+
+export function UsersClient({ users, currentUserId }: Props) {
+  const router = useRouter()
+  const [isPending, startTransition] = useTransition()
+  const [email, setEmail] = useState('')
+
+  function handleInvite() {
+    startTransition(async () => {
+      const result = await inviteAppUserAction(email)
+      if (!result.success) {
+        toast.error(result.error ?? 'Invite failed')
+        return
+      }
+      toast.success(`Invite sent to ${email.trim()}`)
+      setEmail('')
+      router.refresh()
+    })
+  }
+
+  function handleResend(targetEmail: string) {
+    startTransition(async () => {
+      const result = await resendInviteAction(targetEmail)
+      if (!result.success) {
+        toast.error(result.error ?? 'Resend failed')
+        return
+      }
+      toast.success(`Invite resent to ${targetEmail}`)
+      router.refresh()
+    })
+  }
+
+  function handleRemove(user: AppUserRow) {
+    if (!window.confirm(`Remove ${user.email}? They will lose access immediately.`)) return
+
+    startTransition(async () => {
+      const result = await removeAppUserAction(user.id)
+      if (!result.success) {
+        toast.error(result.error ?? 'Remove failed')
+        return
+      }
+      toast.success(`${user.email} removed`)
+      router.refresh()
+    })
+  }
+
+  return (
+    <div className="space-y-6 max-w-3xl">
+      <div className="card rounded-xl p-5 border border-[#1c212a] bg-[#0b0e14]">
