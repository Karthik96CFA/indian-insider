+                        type="button"
+                        disabled={isPending}
+                        onClick={() => handleRemove(user)}
+                        className="px-2.5 py-1.5 rounded border border-[#ef4444]/30 text-[10px] text-[#ef4444] hover:bg-[#ef4444]/10 flex items-center gap-1"
+                      >
+                        <UserX size={11} />
