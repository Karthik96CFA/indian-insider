+import { redirect } from 'next/navigation'
+import { UsersClient } from '@/components/admin/UsersClient'
+import { getIsAdmin } from '@/server/auth/appAccess'
+import { listAppUsers } from '@/server/repositories/appUserRepository'
+import { getAuthenticatedUserId } from '@/server/db/supabase'
+
+export const metadata = { title: 'Users | StockLens Admin' }
+
+export default async function AdminUsersPage() {
+  const isAdmin = await getIsAdmin()
+  if (!isAdmin) redirect('/')
+
+  const [currentUserId, users] = await Promise.all([
+    getAuthenticatedUserId(),
+    listAppUsers().catch(() => []),
+  ])
+
+  return (
+    <div className="space-y-6 animate-fade-in">
+      <div className="page-header">
+        <div className="flex items-center gap-2 mb-1">
+          <span className="badge-pill">Admin</span>
+        </div>
+        <h1 className="page-title">Users</h1>
+        <p className="page-subtitle max-w-2xl mt-2 text-[13px] leading-relaxed">
+          Invite family or collaborators with view-only access. They see the same portfolio and pool data as you
+          but cannot edit holdings, sync broker data, or change settings beyond their own Telegram alerts.
+        </p>
+      </div>
+
+      <UsersClient users={users} currentUserId={currentUserId} />
+    </div>
+  )
+}
