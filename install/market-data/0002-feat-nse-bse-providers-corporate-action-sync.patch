 import type { Instrument } from '@/server/db/schema'
 import type { MarketDataProvider, RawQuote } from '../types'
+import { nseFetch } from '../exchangeHttp'
+
+interface NseQuoteEquity {
+  priceInfo?: {
+    lastPrice?: number
+    pChange?: number
+    previousClose?: number
+    intraDayHighLow?: { max?: number; min?: number }
+  }
+  metadata?: { lastUpdateTime?: string }
+}
+
+async function fetchLiveQuote(symbol: string): Promise<RawQuote | null> {
+  const res = await nseFetch(
+    '/api/quote-equity',
+    { symbol },
+    'https://www.nseindia.com/get-quotes/equity',
+  )
+  if (!res.ok) return null
+
+  const data = (await res.json()) as NseQuoteEquity
+  const price = Number(data.priceInfo?.lastPrice ?? 0)
+  if (!price || price <= 0) return null
+
+  const change_pct = Number(data.priceInfo?.pChange ?? 0)
+  const as_of = data.metadata?.lastUpdateTime
+    ? new Date(data.metadata.lastUpdateTime)
+    : new Date()
+
+  return {
+    price,
+    change_pct,
+    source: 'nse',
+    as_of,
+    fetched_at: new Date(),
+  }
+}
+
+/** EOD bhavcopy close — fallback when live quote unavailable (post 17:30 IST). */
+async function fetchBhavcopyClose(symbol: string): Promise<RawQuote | null> {
+  const now = new Date()
+  for (let daysBack = 0; daysBack < 8; daysBack++) {
+    const d = new Date(now)
+    d.setUTCDate(d.getUTCDate() - daysBack)
+    if (d.getUTCDay() === 0 || d.getUTCDay() === 6) continue
+
+    const dd = String(d.getUTCDate()).padStart(2, '0')
+    const mm = String(d.getUTCMonth() + 1).padStart(2, '0')
+    const yyyy = d.getUTCFullYear()
+    const dateStr = `${dd}${mm}${yyyy}`
+
+    const urls = [
+      `https://nsearchives.nseindia.com/products/content/sec_bhavdata_full_${dateStr}.csv`,
+      `https://archives.nseindia.com/products/content/sec_bhavdata_full_${dateStr}.csv`,
+    ]
+
+    for (const url of urls) {
+      try {
+        const res = await fetch(url, {
+          headers: { 'User-Agent': 'Mozilla/5.0 StockLens/1.0' },
+          signal: AbortSignal.timeout(20_000),
+        })
+        if (!res.ok || res.headers.get('content-length') === '0') continue
+        const text = await res.text()
+        if (text.length < 500) continue
+
+        const close = parseBhavcopyRow(text, symbol)
+        if (close && close > 0) {
+          const as_of = new Date(`${yyyy}-${mm}-${dd}T10:00:00Z`)
+          return {
+            price: close,
+            change_pct: 0,
+            source: 'nse',
+            as_of,
+            fetched_at: new Date(),
+          }
+        }
+      } catch {
+        continue
+      }
+    }
