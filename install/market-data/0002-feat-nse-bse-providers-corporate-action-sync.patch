+import { NextResponse, type NextRequest } from 'next/server'
+import { env } from '@/lib/env'
+import { syncCorporateActions } from '@/services/marketData/corporateActionSync'
+
+export async function GET(request: NextRequest) {
+  const cronSecretHeader = request.headers.get('x-cron-secret')
+  if (!cronSecretHeader || cronSecretHeader !== env.CRON_SECRET) {
+    return NextResponse.json({ error: 'Unauthorized' }, { status: 401 })
+  }
+
+  try {
+    const result = await syncCorporateActions()
+    return NextResponse.json({ success: true, ...result })
+  } catch (error) {
+    console.error('[cron-corporate-actions-sync]', error)
+    return NextResponse.json({ error: 'Internal Server Error' }, { status: 500 })
+  }
+}
