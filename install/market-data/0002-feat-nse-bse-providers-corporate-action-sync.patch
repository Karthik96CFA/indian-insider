+/**
+ * Phase 3 — sync corporate actions from NSE into normalized_corporate_actions.
+ */
+
+import { db } from '@/server/db'
+import { instruments } from '@/server/db/schema'
+import { eq } from 'drizzle-orm'
+import { nseFetch, parseNseDate } from './exchangeHttp'
+import { parseNseCorporateActions } from './corporateActionIngest'
+import { ensureInstrument } from '@/server/repositories/instrumentRepository'
+import { upsertCorporateAction } from '@/server/repositories/marketDataRepository'
+
+function formatNseDate(d: Date): string {
+  const dd = String(d.getDate()).padStart(2, '0')
+  const mm = String(d.getMonth() + 1).padStart(2, '0')
+  const yyyy = d.getFullYear()
+  return `${dd}-${mm}-${yyyy}`
+}
+
+export async function fetchNseCorporateActions(
+  fromDate: Date,
+  toDate: Date,
+): Promise<ReturnType<typeof parseNseCorporateActions>> {
+  const res = await nseFetch(
+    '/api/corporates-corporateActions',
+    {
+      index: 'equities',
+      from_date: formatNseDate(fromDate),
+      to_date: formatNseDate(toDate),
+    },
+    'https://www.nseindia.com/companies-listing/corporate-filings-actions',
+  )
+
+  if (!res.ok) {
+    console.warn(`[corp-sync] NSE corporate actions HTTP ${res.status}`)
+    return []
+  }
+
+  const json = await res.json()
+  return parseNseCorporateActions(json)
+}
+
+export async function syncCorporateActions(options?: {
+  lookbackDays?: number
+  forwardDays?: number
+}): Promise<{ fetched: number; upserted: number; symbolChanges: number }> {
+  const lookback = options?.lookbackDays ?? 30
+  const forward = options?.forwardDays ?? 90
+
+  const toDate = new Date()
+  const fromDate = new Date()
+  fromDate.setDate(fromDate.getDate() - lookback)
+  toDate.setDate(toDate.getDate() + forward)
+
+  const parsed = await fetchNseCorporateActions(fromDate, toDate)
+  let upserted = 0
+  let symbolChanges = 0
+
+  for (const action of parsed) {
+    const instrument = await ensureInstrument(`${action.symbol}-EQ`, action.symbol)
+    const exDate = parseNseDate(action.ex_date) ?? action.ex_date
+
+    await upsertCorporateAction({
+      instrument_id: instrument.id,
+      action_type: action.action_type,
+      ex_date: exDate,
+      ratio_numerator: action.ratio_numerator != null ? String(action.ratio_numerator) : null,
+      ratio_denominator: action.ratio_denominator != null ? String(action.ratio_denominator) : null,
+      old_symbol: action.old_symbol ?? null,
+      new_symbol: action.new_symbol ?? null,
+      source: action.source,
+      notes: action.notes ?? null,
+      payload_json: action.payload_json ?? null,
+    })
+    upserted++
+
+    if (action.action_type === 'symbol_change' && action.new_symbol) {
+      await db
+        .update(instruments)
+        .set({
+          status: 'symbol_changed',
+          updated_at: new Date(),
+        })
+        .where(eq(instruments.id, instrument.id))
+      symbolChanges++
+    }
+
+    if (action.action_type === 'delisting') {
+      await db
+        .update(instruments)
+        .set({ status: 'delisted', updated_at: new Date() })
+        .where(eq(instruments.id, instrument.id))
+    }
+  }
+
+  return { fetched: parsed.length, upserted, symbolChanges }
+}
