+import type { Instrument, NormalizedCorporateAction } from '@/server/db/schema'
+
+export type MarketDataProviderName = 'angel_one' | 'yahoo' | 'nse' | 'bse'
+
+export interface RawQuote {
+  price: number
+  change_pct: number
+  source: MarketDataProviderName
+  as_of: Date
+  fetched_at: Date
+}
+
+export interface NormalizedQuote {
+  ticker: string
+  instrument_id: string
+  price: number
+  change_pct: number
+  source: MarketDataProviderName | 'aggregated'
+  as_of: Date
+  fetched_at: Date
+  raw_price: number
+  is_corp_adjusted: boolean
+  stale_data: boolean
+}
+
+export interface MarketDataProvider {
+  name: MarketDataProviderName
+  priority: number
+  getQuote(instrument: Instrument): Promise<RawQuote | null>
+}
+
+export type CorporateActionRow = Pick<
+  NormalizedCorporateAction,
+  'action_type' | 'ex_date' | 'ratio_numerator' | 'ratio_denominator' | 'old_symbol' | 'new_symbol'
+>
