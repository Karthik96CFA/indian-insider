index 0000000..364df39
--- /dev/null
+++ b/src/services/marketData/marketDataService.ts
@@ -0,0 +1,180 @@
+/**
+ * Market Data Service — single entry point for all price consumers.
+ *
+ * Flow: resolve instrument → read normalized_prices cache → provider fan-out
+ * (Angel → NSE → BSE → Yahoo) → corporate action adjustment → persist
+ * normalized_prices + legacy price_cache.
+ */
+
+import type { PriceData } from '@/services/brokers/types'
+import { isOlderThan24Hours, upsertPrices } from '@/server/repositories/priceRepository'
+import { ensureInstruments } from '@/server/repositories/instrumentRepository'
+import {
+  getCorporateActions,
+  getNormalizedPrices,
+  isNormalizedPriceFresh,
+  upsertNormalizedPrice,
+} from '@/server/repositories/marketDataRepository'
+import { applyCorporateAdjustments } from './corporateActions'
+import { angelProvider } from './providers/angelProvider'
+import { yahooProvider } from './providers/yahooProvider'
+import { nseProvider } from './providers/nseProvider'
+import { bseProvider } from './providers/bseProvider'
+import type { MarketDataProvider, RawQuote } from './types'
+import type { Instrument } from '@/server/db/schema'
+
+const PROVIDERS: MarketDataProvider[] = [
+  angelProvider,
+  nseProvider,
+  bseProvider,
+  yahooProvider,
+].sort((a, b) => a.priority - b.priority)
+
+function toPriceData(ticker: string, quote: {
+  price: number
+  change_pct: number
+  source: PriceData['source']
+  fetched_at: Date
+}): PriceData {
+  return {
+    ticker,
+    price: quote.price,
+    change_pct: quote.change_pct,
+    source: quote.source,
+    fetched_at: quote.fetched_at,
+    stale_data: isOlderThan24Hours(quote.fetched_at),
+  }
+}
+
+function mapSourceToLegacy(source: RawQuote['source'] | 'aggregated'): PriceData['source'] {
+  if (source === 'aggregated') return 'aggregated'
+  if (source === 'nse') return 'nse'
+  if (source === 'bse') return 'bse'
+  return source
+}
+
+async function fetchFromProviders(instrument: Instrument): Promise<RawQuote | null> {
+  for (const provider of PROVIDERS) {
+    const quote = await provider.getQuote(instrument)
+    if (quote && quote.price > 0) return quote
+  }
+  return null
+}
+
+async function resolveQuoteForInstrument(
+  instrument: Instrument,
+  ticker: string,
+  forceRefresh = false,
+): Promise<PriceData> {
+  const cachedMap = await getNormalizedPrices([instrument.id])
+  const cached = cachedMap.get(instrument.id)
+
+  if (!forceRefresh && cached && isNormalizedPriceFresh(cached) && Number(cached.price) > 0) {
+    return toPriceData(ticker, {
+      price: Number(cached.price),
+      change_pct: Number(cached.change_pct),
+      source: cached.source as PriceData['source'],
+      fetched_at: cached.fetched_at,
+    })
+  }
+
+  const raw = await fetchFromProviders(instrument)
+  if (!raw) {
+    if (cached && Number(cached.price) > 0) {
+      return toPriceData(ticker, {
+        price: Number(cached.price),
+        change_pct: Number(cached.change_pct),
+        source: cached.source as PriceData['source'],
+        fetched_at: cached.fetched_at,
+      })
+    }
+    return {
+      ticker,
+      price: 0,
+      change_pct: 0,
+      source: 'yahoo',
+      fetched_at: new Date(0),
+      stale_data: true,
+    }
+  }
+
+  const corpActions = await getCorporateActions(instrument.id)
+  const { adjustedPrice, isAdjusted } = applyCorporateAdjustments(raw.price, corpActions, raw.as_of)
+  const legacySource = mapSourceToLegacy(raw.source)
+
+  await upsertNormalizedPrice({
+    instrument_id: instrument.id,
+    price: String(adjustedPrice),
+    change_pct: String(raw.change_pct),
+    currency: 'INR',
+    source: raw.source,
+    as_of: raw.as_of,
+    fetched_at: raw.fetched_at,
+    raw_price: String(raw.price),
+    is_corp_adjusted: isAdjusted,
+  })
+
+  return toPriceData(ticker, {
+    price: adjustedPrice,
+    change_pct: raw.change_pct,
+    source: legacySource,
+    fetched_at: raw.fetched_at,
+  })
+}
+
+export async function getPrice(ticker: string, forceRefresh = false): Promise<PriceData> {
+  const instrument = await ensureInstruments([ticker]).then((m) => m.get(ticker)!)
+  return resolveQuoteForInstrument(instrument, ticker, forceRefresh)
+}
+
+export async function getPrices(
+  tickers: string[],
+  forceRefresh = false,
+): Promise<Map<string, PriceData>> {
+  const unique = Array.from(new Set(tickers.filter(Boolean)))
+  if (unique.length === 0) return new Map()
+
+  const instrumentMap = await ensureInstruments(unique)
+  const results = new Map<string, PriceData>()
+  const toPersist: Array<{
+    ticker: string
+    price: string
+    change_pct: string
+    source: PriceData['source']
+    fetched_at: Date
+  }> = []
+
+  for (const ticker of unique) {
+    const instrument = instrumentMap.get(ticker)!
+    const quote = await resolveQuoteForInstrument(instrument, ticker, forceRefresh)
+    results.set(ticker, quote)
+    if (quote.price > 0) {
+      toPersist.push({
+        ticker,
+        price: String(quote.price),
+        change_pct: String(quote.change_pct),
+        source: quote.source,
+        fetched_at: quote.fetched_at,
+      })
+    }
+  }
+
+  await upsertPrices(toPersist)
+  return results
+}
+
+/** Refresh all active portfolio tickers — called by cron. */
+export async function syncMarketDataForTickers(tickers: string[]): Promise<{
+  synced: number
+  failed: number
+}> {
+  const prices = await getPrices(tickers, true)
+  let synced = 0
+  let failed = 0
+  for (const ticker of tickers) {
+    const p = prices.get(ticker)
+    if (p && p.price > 0) synced++
+    else failed++
+  }
+  return { synced, failed }
+}
