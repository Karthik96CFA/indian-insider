+/** EOD bhavcopy close — fallback when live quote unavailable (post 17:30 IST). */
+async function fetchBhavcopyClose(symbol: string): Promise<RawQuote | null> {
+  const now = new Date()
+  for (let daysBack = 0; daysBack < 8; daysBack++) {
+    const d = new Date(now)
+    d.setUTCDate(d.getUTCDate() - daysBack)
+    if (d.getUTCDay() === 0 || d.getUTCDay() === 6) continue
+
+    const dd = String(d.getUTCDate()).padStart(2, '0')
+    const mm = String(d.getUTCMonth() + 1).padStart(2, '0')
+    const yyyy = d.getUTCFullYear()
+    const dateStr = `${dd}${mm}${yyyy}`
+
+    const urls = [
+      `https://nsearchives.nseindia.com/products/content/sec_bhavdata_full_${dateStr}.csv`,
+      `https://archives.nseindia.com/products/content/sec_bhavdata_full_${dateStr}.csv`,
+    ]
+
+    for (const url of urls) {
+      try {
+        const res = await fetch(url, {
+          headers: { 'User-Agent': 'Mozilla/5.0 StockLens/1.0' },
+          signal: AbortSignal.timeout(20_000),
+        })
+        if (!res.ok || res.headers.get('content-length') === '0') continue
+        const text = await res.text()
+        if (text.length < 500) continue
+
+        const close = parseBhavcopyRow(text, symbol)
+        if (close && close > 0) {
+          const as_of = new Date(`${yyyy}-${mm}-${dd}T10:00:00Z`)
