+-- Market data layer: canonical instruments, normalized prices, corporate actions
+
+DO $$ BEGIN
+  CREATE TYPE instrument_status AS ENUM ('active', 'suspended', 'delisted', 'symbol_changed');
+EXCEPTION WHEN duplicate_object THEN NULL;
+END $$;
+
+DO $$ BEGIN
+  CREATE TYPE corporate_action_type AS ENUM (
+    'split', 'bonus', 'dividend', 'symbol_change', 'delisting', 'rights', 'merger'
+  );
+EXCEPTION WHEN duplicate_object THEN NULL;
+END $$;
+
+DO $$ BEGIN
+  CREATE TYPE market_data_source AS ENUM ('angel_one', 'yahoo', 'nse', 'bse', 'aggregated');
+EXCEPTION WHEN duplicate_object THEN NULL;
+END $$;
+
+ALTER TYPE price_source ADD VALUE IF NOT EXISTS 'nse';
+ALTER TYPE price_source ADD VALUE IF NOT EXISTS 'bse';
+ALTER TYPE price_source ADD VALUE IF NOT EXISTS 'aggregated';
+
+CREATE TABLE IF NOT EXISTS instruments (
+  id                  UUID PRIMARY KEY DEFAULT gen_random_uuid(),
+  canonical_symbol    TEXT NOT NULL,
+  exchange            TEXT NOT NULL DEFAULT 'NSE',
+  bse_scrip_code      TEXT,
+  angel_broker_symbol TEXT,
+  yahoo_symbol        TEXT,
+  company_name        TEXT,
+  status              instrument_status NOT NULL DEFAULT 'active',
+  superseded_by       UUID REFERENCES instruments(id) ON DELETE SET NULL,
+  created_at          TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+  updated_at          TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+  CONSTRAINT instruments_symbol_exchange_uniq UNIQUE (canonical_symbol, exchange)
+);
+
+CREATE INDEX IF NOT EXISTS instruments_angel_broker_symbol_idx ON instruments (angel_broker_symbol);
+CREATE INDEX IF NOT EXISTS instruments_bse_scrip_code_idx ON instruments (bse_scrip_code);
+CREATE INDEX IF NOT EXISTS instruments_status_idx ON instruments (status);
+
+CREATE TABLE IF NOT EXISTS normalized_prices (
+  instrument_id   UUID PRIMARY KEY REFERENCES instruments(id) ON DELETE CASCADE,
+  price           NUMERIC(12, 4) NOT NULL,
+  change_pct      NUMERIC(8, 4) NOT NULL DEFAULT 0,
+  currency        TEXT NOT NULL DEFAULT 'INR',
+  source          market_data_source NOT NULL,
+  as_of           TIMESTAMPTZ NOT NULL,
+  fetched_at      TIMESTAMPTZ NOT NULL,
+  raw_price       NUMERIC(12, 4),
+  is_corp_adjusted BOOLEAN NOT NULL DEFAULT FALSE,
+  updated_at      TIMESTAMPTZ NOT NULL DEFAULT NOW()
+);
+
+CREATE INDEX IF NOT EXISTS normalized_prices_fetched_at_idx ON normalized_prices (fetched_at);
+
+CREATE TABLE IF NOT EXISTS normalized_corporate_actions (
+  id              UUID PRIMARY KEY DEFAULT gen_random_uuid(),
+  instrument_id   UUID NOT NULL REFERENCES instruments(id) ON DELETE CASCADE,
+  action_type     corporate_action_type NOT NULL,
+  ex_date         DATE NOT NULL,
+  ratio_numerator   NUMERIC(12, 4),
+  ratio_denominator NUMERIC(12, 4),
+  old_symbol      TEXT,
+  new_symbol      TEXT,
+  source          TEXT NOT NULL DEFAULT 'manual',
+  notes           TEXT,
+  payload_json    JSONB,
+  created_at      TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+  CONSTRAINT normalized_corp_actions_uniq UNIQUE (instrument_id, action_type, ex_date)
+);
+
+CREATE INDEX IF NOT EXISTS normalized_corp_actions_instrument_idx
+  ON normalized_corporate_actions (instrument_id, ex_date DESC);
