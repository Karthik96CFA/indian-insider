+
+function parseBhavcopyRow(csv: string, symbol: string): number | null {
+  const lines = csv.split('\n')
+  if (lines.length < 2) return null
+  const header = lines[0]!.split(',').map((h) => h.trim().replace(/"/g, ''))
+  const symIdx = header.indexOf('SYMBOL')
+  const seriesIdx = header.indexOf('SERIES')
+  const closeIdx = header.indexOf('CLOSE_PRICE')
+  if (symIdx < 0 || closeIdx < 0) return null
+
+  const target = symbol.toUpperCase()
+  for (let i = 1; i < lines.length; i++) {
+    const cols = lines[i]!.split(',').map((c) => c.trim().replace(/"/g, ''))
+    if (cols[symIdx]?.toUpperCase() !== target) continue
+    if (seriesIdx >= 0 && cols[seriesIdx] !== 'EQ') continue
+    const close = parseFloat(cols[closeIdx] ?? '0')
+    if (close > 0) return close
+  }
