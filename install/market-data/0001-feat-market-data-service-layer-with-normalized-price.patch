@@ -0,0 +1,79 @@
+import { and, eq, inArray, or } from 'drizzle-orm'
+import { db } from '@/server/db'
+import { instruments } from '@/server/db/schema'
+import type { Instrument, NewInstrument } from '@/server/db/schema'
+import { stripBrokerSuffix, isBseBrokerSymbol } from '@/services/brokers/exchangeUtils'
+import { toYahooSymbol } from '@/services/brokers/symbolMapper'
+
+export async function findInstrumentByTicker(ticker: string): Promise<Instrument | null> {
+  const base = stripBrokerSuffix(ticker).toUpperCase()
+  const angel = ticker.includes('-') ? ticker.toUpperCase() : `${base}-EQ`
+  const exchange = isBseBrokerSymbol(ticker) ? 'BSE' : 'NSE'
+
+  const rows = await db
+    .select()
+    .from(instruments)
+    .where(
+      or(
+        and(eq(instruments.canonical_symbol, base), eq(instruments.exchange, exchange)),
+        eq(instruments.angel_broker_symbol, angel),
+        eq(instruments.canonical_symbol, ticker.toUpperCase()),
+      )
+    )
+    .limit(1)
+
+  return rows[0] ?? null
+}
+
+export async function ensureInstrument(ticker: string, companyName?: string): Promise<Instrument> {
+  const existing = await findInstrumentByTicker(ticker)
+  if (existing) return existing
+
+  const base = stripBrokerSuffix(ticker).toUpperCase()
+  const exchange = isBseBrokerSymbol(ticker) ? 'BSE' : 'NSE'
+  const angel = ticker.includes('-') ? ticker.toUpperCase() : `${base}-EQ`
+  let yahooSymbol = `${base}.NS`
+  try {
+    yahooSymbol = await toYahooSymbol(angel)
+  } catch {
+    yahooSymbol = exchange === 'BSE' ? `${base}.BO` : `${base}.NS`
+  }
+
+  const row: NewInstrument = {
+    canonical_symbol: base,
+    exchange,
+    angel_broker_symbol: angel,
+    yahoo_symbol: yahooSymbol,
+    company_name: companyName ?? null,
+    status: 'active',
+  }
+
+  const inserted = await db
+    .insert(instruments)
+    .values(row)
+    .onConflictDoUpdate({
+      target: [instruments.canonical_symbol, instruments.exchange],
+      set: {
+        angel_broker_symbol: angel,
+        yahoo_symbol: yahooSymbol,
+        updated_at: new Date(),
+      },
+    })
+    .returning()
+
+  return inserted[0]!
+}
+
+export async function ensureInstruments(tickers: string[]): Promise<Map<string, Instrument>> {
+  const unique = Array.from(new Set(tickers.filter(Boolean)))
+  const map = new Map<string, Instrument>()
+  for (const ticker of unique) {
+    map.set(ticker, await ensureInstrument(ticker))
+  }
+  return map
+}
+
+export async function getInstrumentsByIds(ids: string[]): Promise<Instrument[]> {
+  if (ids.length === 0) return []
+  return db.select().from(instruments).where(inArray(instruments.id, ids))
+}
