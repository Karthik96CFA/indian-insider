@@ -0,0 +1,38 @@
+import type { CorporateActionRow } from './types'
+
+/** Apply split/bonus adjustments to a raw exchange price (multiplicative factors). */
+export function applyCorporateAdjustments(
+  rawPrice: number,
+  actions: CorporateActionRow[],
+  asOf: Date = new Date(),
+): { adjustedPrice: number; isAdjusted: boolean } {
+  if (!Number.isFinite(rawPrice) || rawPrice <= 0 || actions.length === 0) {
+    return { adjustedPrice: rawPrice, isAdjusted: false }
+  }
+
+  const asOfDay = asOf.toISOString().slice(0, 10)
+  let factor = 1
+  let adjusted = false
+
+  for (const action of actions) {
+    const exDay = String(action.ex_date)
+    if (exDay > asOfDay) continue
+
+    const num = Number(action.ratio_numerator ?? 0)
+    const den = Number(action.ratio_denominator ?? 0)
+
+    if (action.action_type === 'split' && num > 0 && den > 0) {
+      // e.g. 1:2 split → price halves
+      factor *= num / den
+      adjusted = true
+    } else if (action.action_type === 'bonus' && num > 0 && den > 0) {
+      // e.g. 1:1 bonus → 2x shares → price halves
+      factor *= den / (num + den)
+      adjusted = true
+    }
+    // symbol_change / delisting handled at instrument resolution layer
+  }
+
+  if (!adjusted) return { adjustedPrice: rawPrice, isAdjusted: false }
+  return { adjustedPrice: rawPrice * factor, isAdjusted: true }
+}
diff --git a/src/services/marketData/marketDataService.ts b/src/services/marketData/marketDataService.ts
