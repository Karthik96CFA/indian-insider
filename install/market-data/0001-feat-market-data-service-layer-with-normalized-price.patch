+import { desc, eq, inArray } from 'drizzle-orm'
+import { db } from '@/server/db'
+import {
+  normalizedCorporateActions,
+  normalizedPrices,
+} from '@/server/db/schema'
+import type {
+  NewNormalizedCorporateAction,
+  NewNormalizedPrice,
+  NormalizedCorporateAction,
+  NormalizedPrice,
+} from '@/server/db/schema'
+
+const FRESH_MS = 5 * 60 * 1000
+
+export function isNormalizedPriceFresh(row: NormalizedPrice): boolean {
+  return Date.now() - row.fetched_at.getTime() < FRESH_MS
+}
+
+export async function getNormalizedPrices(
+  instrumentIds: string[],
+): Promise<Map<string, NormalizedPrice>> {
+  if (instrumentIds.length === 0) return new Map()
+  const rows = await db
+    .select()
+    .from(normalizedPrices)
+    .where(inArray(normalizedPrices.instrument_id, instrumentIds))
+  return new Map(rows.map((r) => [r.instrument_id, r]))
+}
+
+export async function upsertNormalizedPrice(data: NewNormalizedPrice): Promise<void> {
+  await db
+    .insert(normalizedPrices)
+    .values(data)
+    .onConflictDoUpdate({
+      target: normalizedPrices.instrument_id,
+      set: {
+        price: data.price,
+        change_pct: data.change_pct,
+        source: data.source,
+        as_of: data.as_of,
+        fetched_at: data.fetched_at,
+        raw_price: data.raw_price,
+        is_corp_adjusted: data.is_corp_adjusted,
+        updated_at: new Date(),
+      },
+    })
+}
+
+export async function upsertNormalizedPrices(rows: NewNormalizedPrice[]): Promise<void> {
+  for (const row of rows) {
+    await upsertNormalizedPrice(row)
+  }
+}
+
+export async function getCorporateActions(
+  instrumentId: string,
+): Promise<NormalizedCorporateAction[]> {
+  return db
+    .select()
+    .from(normalizedCorporateActions)
+    .where(eq(normalizedCorporateActions.instrument_id, instrumentId))
+    .orderBy(desc(normalizedCorporateActions.ex_date))
+}
+
+export async function upsertCorporateAction(
+  data: NewNormalizedCorporateAction,
+): Promise<void> {
+  await db
+    .insert(normalizedCorporateActions)
+    .values(data)
+    .onConflictDoNothing()
+}
