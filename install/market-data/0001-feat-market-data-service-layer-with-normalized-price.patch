+import { describe, expect, it } from 'vitest'
+import { applyCorporateAdjustments } from './corporateActions'
+
+describe('applyCorporateAdjustments', () => {
+  it('halves price on 1:2 split after ex-date', () => {
+    const { adjustedPrice, isAdjusted } = applyCorporateAdjustments(
+      1000,
+      [{
+        action_type: 'split',
+        ex_date: '2024-01-01',
+        ratio_numerator: 1,
+        ratio_denominator: 2,
+        old_symbol: null,
+        new_symbol: null,
+      }],
+      new Date('2024-06-01'),
+    )
+    expect(isAdjusted).toBe(true)
+    expect(adjustedPrice).toBe(500)
+  })
+
+  it('halves price on 1:1 bonus', () => {
+    const { adjustedPrice, isAdjusted } = applyCorporateAdjustments(
+      200,
+      [{
+        action_type: 'bonus',
+        ex_date: '2024-03-01',
+        ratio_numerator: 1,
+        ratio_denominator: 1,
+        old_symbol: null,
+        new_symbol: null,
+      }],
+      new Date('2024-06-01'),
+    )
+    expect(isAdjusted).toBe(true)
+    expect(adjustedPrice).toBe(100)
+  })
+
+  it('ignores future corporate actions', () => {
+    const { adjustedPrice, isAdjusted } = applyCorporateAdjustments(
+      100,
+      [{
+        action_type: 'split',
+        ex_date: '2025-12-01',
+        ratio_numerator: 1,
+        ratio_denominator: 2,
+        old_symbol: null,
+        new_symbol: null,
+      }],
+      new Date('2024-06-01'),
+    )
+    expect(isAdjusted).toBe(false)
+    expect(adjustedPrice).toBe(100)
+  })
+})
