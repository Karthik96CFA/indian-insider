@@ -0,0 +1,107 @@
+import type { NewNormalizedCorporateAction } from '@/server/db/schema'
+
+export interface ParsedCorporateAction {
+  symbol: string
+  action_type: NewNormalizedCorporateAction['action_type']
+  ex_date: string
+  ratio_numerator?: number
+  ratio_denominator?: number
+  old_symbol?: string
+  new_symbol?: string
+  notes?: string
+  source: string
+  payload_json?: Record<string, unknown>
+}
+
+/** Classify NSE/BSE subject line into action type + ratio. */
+export function classifyCorporateSubject(subject: string): {
+  action_type: ParsedCorporateAction['action_type']
+  ratio_numerator?: number
+  ratio_denominator?: number
+} {
+  const s = subject.toLowerCase()
+
+  if (s.includes('stock split') || s.includes('sub-division') || s.includes('subdivision')) {
+    const ratio = parseRatio(subject)
+    return { action_type: 'split', ...ratio }
+  }
+  if (s.includes('bonus')) {
+    const ratio = parseRatio(subject)
+    return { action_type: 'bonus', ...ratio }
+  }
+  if (s.includes('rights')) {
+    const ratio = parseRatio(subject)
+    return { action_type: 'rights', ...ratio }
+  }
+  if (s.includes('dividend')) {
+    return { action_type: 'dividend' }
+  }
+  if (s.includes('delist')) {
+    return { action_type: 'delisting' }
+  }
+  if (s.includes('merger') || s.includes('amalgamation')) {
+    return { action_type: 'merger' }
+  }
+  if (s.includes('name change') || s.includes('symbol change')) {
+    return { action_type: 'symbol_change' }
+  }
+  return { action_type: 'dividend' }
+}
+
+/** Parse "Bonus 1:1", "Split from Rs 10 to Rs 5", "1:2" patterns. */
+export function parseRatio(text: string): { ratio_numerator?: number; ratio_denominator?: number } {
+  const m = text.match(/(\d+)\s*:\s*(\d+)/)
+  if (!m) return {}
+  return {
+    ratio_numerator: Number(m[1]),
+    ratio_denominator: Number(m[2]),
+  }
+}
+
+export function parseNseCorporateActions(payload: unknown): ParsedCorporateAction[] {
+  const rows = Array.isArray(payload)
+    ? payload
+    : (payload as { data?: unknown[] })?.data ?? []
+
+  const out: ParsedCorporateAction[] = []
+
+  for (const row of rows) {
+    if (!row || typeof row !== 'object') continue
+    const r = row as Record<string, unknown>
+    const symbol = String(r.symbol ?? r.SYMBOL ?? '').trim().toUpperCase()
+    const subject = String(r.subject ?? r.SUBJECT ?? r.purpose ?? r.PURPOSE ?? '').trim()
+    const exRaw = String(r.exDate ?? r.EX_DATE ?? r.exdate ?? '')
+    const ex_date = normalizeExDate(exRaw)
+    if (!symbol || !ex_date) continue
+
+    const { action_type, ratio_numerator, ratio_denominator } = classifyCorporateSubject(subject)
+
+    out.push({
+      symbol,
+      action_type,
+      ex_date,
+      ratio_numerator,
+      ratio_denominator,
+      notes: subject,
+      source: 'nse',
+      payload_json: r,
+    })
+  }
+
+  return out
+}
+
+function normalizeExDate(raw: string): string | null {
+  if (!raw) return null
+  const iso = /^\d{4}-\d{2}-\d{2}$/.test(raw)
+  if (iso) return raw
+  const m = raw.match(/^(\d{1,2})-([A-Za-z]{3})-(\d{4})$/)
+  if (!m) return null
+  const months: Record<string, string> = {
+    Jan: '01', Feb: '02', Mar: '03', Apr: '04', May: '05', Jun: '06',
+    Jul: '07', Aug: '08', Sep: '09', Oct: '10', Nov: '11', Dec: '12',
+  }
+  const mon = months[m[2]!]
+  if (!mon) return null
+  return `${m[3]}-${mon}-${m[1]!.padStart(2, '0')}`
+}
