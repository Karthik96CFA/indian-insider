# Indian Insider — environment config
# Copy to ~/indian-insider/.env — never commit secrets.

# ── REQUIRED — Google Gemini ──────────────────────────────────────────────────
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── REQUIRED — Gmail SMTP ─────────────────────────────────────────────────────
# App password (16 chars from Google — NOT your regular Gmail password):
# https://myaccount.google.com/apppasswords
# Quote values that contain # or spaces, e.g. GMAIL_APP_PASSWORD="your@pass#word"
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_TO=

# ── OPTIONAL — Angel One (Dekisugi portfolio drift) ───────────────────────────
ANGELONE_API_KEY=
ANGELONE_CLIENT_ID=
ANGELONE_MPIN=
ANGELONE_TOTP_SECRET=

# ── OPTIONAL — Telegram (Gian + daily briefing) ─────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── OPTIONAL — PostgreSQL (default: SQLite at ~/.state/state.db) ──────────────
# DATABASE_URL=postgresql://user:pass@localhost/indian_insider

# ── ADVANCED ──────────────────────────────────────────────────────────────────
# GEMINI_MODEL=gemini-2.5-flash
# DORAEMI_MIN_AGREE=4
# DORAEMI_WINDOW_DAYS=7
